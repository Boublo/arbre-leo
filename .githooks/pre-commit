#!/bin/sh
# Crochet git pre-commit pour « L'arbre de Léo ».
#
# Ce fichier n'est actif qu'après :
#
#     git config core.hooksPath .githooks
#
# 1. Données sensibles (patronymes, secrets, GEDCOM…) — toujours.
# 2. Garde-fous arbre — si des fichiers arbre sont dans le staging.

set -e

node scripts/verifier-avant-commit.mjs

if git diff --cached --name-only | grep -qE \
  '^(src/components/arbre/|src/app/arbre/|src/app/actions/arbre\.ts|src/lib/(layout-arbre|geometrie-liens|arbre-graphe)\.ts|src/components/interactions/panneau-mobile\.tsx|scripts/(verifier|test-geometrie))'; then
  echo ""
  echo "Fichiers arbre détectés — lancement des garde-fous anti-régression…"
  node scripts/verifier-arbre.mjs
fi
