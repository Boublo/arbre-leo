# Copiez ce fichier en `.env.local` et renseignez les valeurs.
# Aucune donnée familiale ici — uniquement la configuration technique.

# --- Supabase (obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Site (recommandé en production) ---
# Domaine canonique, sans slash final. Sert aux redirections auth.
NEXT_PUBLIC_SITE_URL=https://exemple.vercel.app

# --- Habillage (optionnel) ---
NEXT_PUBLIC_NOM_DU_SITE=L'arbre de la famille
NEXT_PUBLIC_SOUS_TITRE=L'histoire d'une famille, racontée ensemble.
NEXT_PUBLIC_PRENOM_RACINE=L'enfant
# Identifiant UUID de la personne racine (prioritaire sur le prénom ci-dessus).
# NEXT_PUBLIC_PERSONNE_RACINE=
NEXT_PUBLIC_BRANCHE_PATERNELLE=paternelle
NEXT_PUBLIC_BRANCHE_MATERNELLE=maternelle

# --- Assistance IA optionnelle (serveur uniquement, admin) ---
# Sans cette clé, le résumé de branche reste déterministe (recommandé).
# Ne jamais préfixer NEXT_PUBLIC_ : la clé ne doit pas partir au navigateur.
# ARBRE_IA_CLE=

# --- Scripts locaux uniquement (jamais dans Vercel) ---
# ARBRE_EMAIL=vous@exemple.fr
# ARBRE_MOTDEPASSE=
